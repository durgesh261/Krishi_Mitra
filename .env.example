# Krishi Mitra (कृषि मित्र) - Environment Configuration Template
# Copy this file to .env and provide your API keys

# Groq Cloud API Key (Get free key from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Chat Models (Choose any latest supported model):
# Options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant, deepseek-r1-distill-llama-70b
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Groq Vision Models for leaf & disease image diagnosis:
# Options: llama-3.2-11b-vision-preview, llama-3.2-90b-vision-preview
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# OpenWeatherMap API Key for live agricultural weather forecasts
WEATHER_API_KEY=your_openweather_api_key_here

# Secret key for Flask user sessions & authentication security
SECRET_KEY=your_flask_secret_key_here

# OpenCage Geocoder API Key for GPS farmer district & state geocoding
OPENCAGE_API_KEY=your_opencage_api_key_here
